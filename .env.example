# MySQL pool size (default 10). After message:send SQL reductions, 15–20 is
# reasonable under concurrent load — tune from metrics.
# DB_POOL_SIZE=15  

# App 
APP_NAME=Alanya
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend for Alanya chat application
APP_AUTHOR=Alanya
APP_LICENSE=MIT
LOGO_URL=https://www.alanya237.com/uploads/images/alanya-officiel.png

# Avatar imposé aux comptes officiels (account_type = 2). À défaut, LOGO_URL.
OFFICIAL_ACCOUNT_AVATAR_URL=https://www.alanya237.com/uploads/images/alanya-officiel.png

AVATAR_DEFAULT_MALE=https://www.alanya237.com/uploads/images/default_avatar_male.png
AVATAR_DEFAULT_FEMALE=https://www.alanya237.com/uploads/images/default_avatar_female.png


# # MySQL Configuration
# DB_HOST=163.123.183.89
# DB_PORT=17705
# DB_NAME=alanyaBD2026
# DB_USER=trump
# DB_PASSWORD=Kendra2026

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=

# Chiffrement des codes de récupération de compte (users.recovery_code_enc).
# 32 octets en base64 : openssl rand -base64 32
# Si absente, la clé est dérivée de JWT_SECRET et un avertissement est logué.
#
# ⚠ CHANGER CETTE VALEUR (ou JWT_SECRET si l'on est sur le repli) rend TOUS les
# codes de récupération déjà émis indéchiffrables : leurs propriétaires perdent
# silencieusement leur seule voie de retour s'ils n'ont pas d'e-mail.
# RECOVERY_CODE_KEY=

# Firebase Service Account (JSON stringified)
FIREBASE_SERVICE_ACCOUNT=

# FCM - Uses Firebase Admin SDK HTTP v1 (via FIREBASE_SERVICE_ACCOUNT)
# No FCM_SERVER_KEY needed (old method, less secure)

# Phase 4 — MessagingStyle Android (FCM data-only pour messages)
# Doit être true en même temps que talkyNotificationNativeV2=true côté app.
NOTIFICATION_ANDROID_NATIVE_V2=true

# APNs VoIP (Phase 6.2) — clé .p8 Apple Developer, jamais committer le secret
# IOS_VOIP_V2=true
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.example.talkyFlutter
# APNS_KEY_PATH=/path/to/AuthKey_XXXX.p8
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_PRODUCTION=false
# APNS_VOIP_TTL_SEC=60

# TURN / ICE (GET /api/turn/credentials)
# auth: "static" = username/credential du JSON ; "auth": "hmac" = credentials éphémères via TURN_SECRET
# TURN_SECRET=
# TURN_TTL_SEC=86400
# TURN_SERVERS=[{"urls":["turn:example.com:3478"],"username":"user","credential":"pass","auth":"static"},{"urls":["stun:coturn.example:3478","turn:coturn.example:3478?transport=udp","turns:coturn.example:5349?transport=tcp"],"auth":"hmac"}]

# ── Volet QR : page d'accueil publique et liens universels ────────────
# Base des URL encodées dans les QR (identité et connexion). Doit correspondre
# au domaine réellement servi, sinon les codes déjà en circulation cassent.
# QR_BASE_URL=https://www.alanya237.com

# Schéma applicatif du bouton « Ouvrir dans Alanya » de la page d'accueil.
# Fonctionne sans aucun certificat, contrairement aux liens universels.
# QR_APP_SCHEME=alanya

# Liens de téléchargement affichés à qui n'a pas encore l'app (optionnels :
# les boutons disparaissent si la variable est vide).
# QR_PLAY_STORE_URL=
# QR_APP_STORE_URL=

# ── Android App Links (ouverture directe de l'app depuis un lien https) ──
# Empreintes SHA-256 du ou des certificats de signature, séparées par des
# virgules. Sans elles, /.well-known/assetlinks.json renvoie 404 et Android
# ouvre le navigateur — dégradation, pas panne : la page propose le bouton
# en schéma applicatif.
#
# Empreinte de la clé DEBUG (celle qui signe aussi les builds release
# actuels, cf. signingConfigs.getByName("debug") dans app/build.gradle.kts) :
#   keytool -list -v -alias androiddebugkey \
#     -keystore ~/.android/debug.keystore -storepass android -keypass android
#
# ⚠ À LA PUBLICATION SUR LE PLAY STORE : Google re-signe l'application. Il faut
# AJOUTER (sans retirer celle-ci) l'empreinte du Play App Signing, relevée dans
# Console Play → Configuration → Intégrité de l'application → Certificat de la
# clé de signature de l'app → SHA-256. Tant que ce n'est pas fait, les liens
# https ouvriront le navigateur sur les installations venues du Store.
# QR_ANDROID_SHA256=2A:A0:3C:ED:2F:5F:C2:53:70:29:D7:F6:8C:C2:35:F5:4C:17:B2:82:FB:99:54:2C:2E:62:AE:37:A1:9D:C3:0D
# QR_ANDROID_PACKAGE=com.alanya237.alanya

# ── iOS Universal Links (non configurés) ─────────────────────────────
# Team ID Apple, 10 caractères : developer.apple.com → Membership details.
# Tant qu'il est vide, /.well-known/apple-app-site-association renvoie 404 et
# iOS s'en tient au schéma alanya:// — l'app s'ouvre par le bouton de la page.
# QR_IOS_TEAM_ID=
# QR_IOS_BUNDLE_ID=com.alanya237.alanya
